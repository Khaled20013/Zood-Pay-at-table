{
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/((?!.*\\.).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(index.html|flutter_bootstrap.js|flutter_service_worker.js|main.dart.js|version.json|manifest.json)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/.well-known/(apple-app-site-association|assetlinks.json)",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    }
  ]
}
